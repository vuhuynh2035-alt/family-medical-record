{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "AGENTS.md",
      "GEMINI.md",
      "BAO_CAO_NANG_CAP.md",
      "*.bat",
      "*.vbs",
      "*.sh",
      "server.js",
      "package.json",
      "package-lock.json",
      "Dockerfile",
      "docker-compose.yml",
      "nginx.conf",
      "tests/**",
      "test-results/**",
      "scripts/**"
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}